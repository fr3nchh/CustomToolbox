<UserControl x:Class="CustomToolbox.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Titre en haut -->
        <TextBlock Grid.Row="0" Text="Paramètres" FontSize="28" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,28"/>

        <!-- Cartes en haut -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700" HorizontalAlignment="Center">

            <!-- Mise à jour -->
            <Border Style="{StaticResource SettingsCard}">
                <DockPanel>
                    <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,16,0"
                            Background="{DynamicResource SurfaceBrush}">
                        <Path Data="M21 10.12h-6.78l2.74-2.82c-2.73-2.7-7.15-2.8-9.88-.1-2.73 2.71-2.73 7.08 0 9.79 2.73 2.71 7.15 2.71 9.88 0 1.36-1.36 2.14-3.15 2.3-5.01h-2.3c-.15 1.32-.76 2.53-1.68 3.43-1.92 1.92-5.06 1.92-6.98 0-1.92-1.92-1.92-5.06 0-6.98 1.92-1.92 5.06-1.92 6.98 0l2.74 2.82V10.12zM12.5 8v4.25l3.5 2.08-.72 1.21L11 13V8h1.5z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Width="20" Height="20" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mise à jour" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Vérifier les mises à jour de la toolbox"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="Vérifier"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Right" Margin="16,0,0,0"/>
                </DockPanel>
            </Border>

            <!-- Winget -->
            <Border Style="{StaticResource SettingsCard}">
                <DockPanel>
                    <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,16,0"
                            Background="{DynamicResource SurfaceBrush}">
                        <Path Data="M20 2H4c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 14H8v-2h4v2zm4-4H8v-2h8v2zm0-4H8V6h8v2z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Width="20" Height="20" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Windows Package Manager" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Gestionnaire de paquets pour l'installation d'applications"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="Vérifier"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Right" Margin="16,0,0,0"
                            Click="OnCheckWinget_Click"/>
                </DockPanel>
            </Border>

            <!-- À propos -->
            <Border Style="{StaticResource SettingsCard}">
                <DockPanel>
                    <Border Width="40" Height="40" CornerRadius="10" Margin="0,0,16,0"
                            Background="{DynamicResource SurfaceBrush}">
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"
                              Fill="{DynamicResource TextSecondaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Width="20" Height="20" Stretch="Uniform"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="À propos" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Custom Toolbox v1.0.0 — Pour OS Custom"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
