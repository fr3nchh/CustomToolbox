<UserControl x:Class="CustomToolbox.Views.OptimizeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CustomToolbox.ViewModels"
             xmlns:models="clr-namespace:CustomToolbox.Models">

    <UserControl.DataContext>
        <vm:OptimizeViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Optimisation" FontSize="28" FontWeight="Bold" FontStyle="Italic"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Optimisez les performances et la confidentialité de Windows"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="10" Padding="12" Margin="0,0,16,0"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CATÉGORIES" FontWeight="SemiBold"
                               FontSize="11" Margin="8,8,8,12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <ListBox x:Name="CategoryList" DockPanel.Dock="Top"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:OptimizationCategory}">
                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="{Binding Icon}" FontSize="14" Margin="0,0,10,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Settings Panel -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,0,16">
                    <!-- Search -->
                    <TextBox Style="{StaticResource SearchTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16"/>

                    <!-- Toggle Settings -->
                    <ItemsControl ItemsSource="{Binding SelectedCategory.ToggleSettings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ToggleSetting}">
                                <Border Background="{DynamicResource CardBrush}"
                                        CornerRadius="8" Padding="16" Margin="0,0,0,8"
                                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                        Visibility="{Binding MatchesSearch, Converter={StaticResource BoolToVisibility}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <CheckBox x:Name="Toggle" Grid.Column="1"
                                                  IsChecked="{Binding IsCurrentValue, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0,0,0"
                                                  Tag="{Binding}"
                                                  Checked="OnToggleChecked"
                                                  Unchecked="OnToggleUnchecked"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Selection Settings -->
                    <ItemsControl ItemsSource="{Binding SelectedCategory.SelectionSettings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:SelectionSetting}">
                                <Border Background="{DynamicResource CardBrush}"
                                        CornerRadius="8" Padding="16" Margin="0,0,0,8"
                                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                                        Visibility="{Binding MatchesSearch, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap" Margin="0,2,0,8"/>

                                        <ComboBox DisplayMemberPath="Label"
                                                  SelectedValue="{Binding CurrentValue}"
                                                  SelectedValuePath="Value"
                                                  Tag="{Binding}"
                                                  SelectionChanged="OnSelectionChanged">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox">
                                                    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                    <Setter Property="BorderThickness" Value="1"/>
                                                    <Setter Property="Padding" Value="10,6"/>
                                                    <Setter Property="FontSize" Value="12"/>
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
