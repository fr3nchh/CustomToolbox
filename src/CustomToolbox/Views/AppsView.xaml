<UserControl x:Class="CustomToolbox.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CustomToolbox.ViewModels"
             xmlns:models="clr-namespace:CustomToolbox.Models">

    <UserControl.DataContext>
        <vm:AppsViewModel/>
    </UserControl.DataContext>

    <Grid>
        <!-- Contenu principal -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Catalogue" FontSize="28" FontWeight="Bold" FontStyle="Italic"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Applications open-source, installées en un geste"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Contenu -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Catégories -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                    CornerRadius="10" Padding="12" Margin="0,0,16,0"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CATÉGORIES" FontWeight="SemiBold"
                               FontSize="11" Margin="8,8,8,12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>

                    <!-- Bouton "Toutes" -->
                    <Button x:Name="AllCategoriesBtn" DockPanel.Dock="Top"
                            Content="  Toutes les apps"
                            Margin="0,0,0,4"
                            Style="{StaticResource SecondaryButton}"
                            Click="OnAllCategories_Click"/>

                    <!-- Boutons catégorie -->
                    <ListBox x:Name="CategoryList" DockPanel.Dock="Top"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectionChanged="OnCategoryList_SelectionChanged"
                             ItemContainerStyle="{StaticResource SidebarItemStyle}">
                        <ListBoxItem Tag="Navigateurs">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" 
                                      Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Navigateurs" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Communication">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"
                                      Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Communication" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Musique &amp; Audio">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55C7.79 13 6 14.79 6 17s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                      Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Musique &amp; Audio" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Vidéo &amp; Streaming">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M18 4l2 4h-3l-2-4h-2l2 4h-3l-2-4H8l2 4H7L5 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V4h-4z"
                                      Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Vidéo &amp; Streaming" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Jeux">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M21.58 16.09l-1.09-7.66C20.21 6.46 18.52 5 16.53 5H7.47C5.48 5 3.79 6.46 3.51 8.43l-1.09 7.66C2.2 17.63 3.39 19 4.94 19h0c.68 0 1.32-.27 1.8-.75L9 16h6l2.25 2.25c.48.48 1.13.75 1.8.75h0c1.56 0 2.75-1.37 2.53-2.91zM11 11H9v2H8v-2H6v-1h2V8h1v2h2v1zm4 2c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm2-3c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z"
                                      Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Jeux" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Développement">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"
                                      Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Développement" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Utilitaires">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"
                                      Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Utilitaires" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Bureautique">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"
                                      Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Bureautique" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Graphisme &amp; Création">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M7 14c-1.66 0-3 1.34-3 3 0 1.31-1.16 2-2 2 .92 1.22 2.49 2 4 2 2.21 0 4-1.79 4-4 0-1.66-1.34-3-3-3zm13.71-9.37l-1.34-1.34a.996.996 0 00-1.41 0L9 12.25 11.75 15l8.96-8.96a.996.996 0 000-1.41z"
                                      Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Graphisme &amp; Création" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Sécurité &amp; Vie Privée">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"
                                      Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Sécurité &amp; Vie Privée" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Zone apps : recherche + grille -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barre de recherche -->
                <TextBox Grid.Row="0" Style="{StaticResource SearchTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"/>

            <!-- Grid des applications -->
            <ScrollViewer x:Name="AppScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Style="{StaticResource InvisibleScrollViewer}">
                <StackPanel>
                <ItemsControl ItemsSource="{Binding FilteredApps}" VerticalAlignment="Top">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AppInfo}">
                            <Button Style="{StaticResource AppCardButton}"
                                    Tag="{Binding}"
                                    Click="OnCardClick"
                                    Width="Auto" Height="120"
                                    Margin="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="20"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Icone + Nom + Catégorie -->
                                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                                        <Grid Width="40" Height="40" Margin="0,0,14,0">
                                            <Image Source="{Binding IconUrl}"
                                                   Width="40" Height="40"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Stretch="Uniform"
                                                   ImageFailed="OnIconImageFailed"/>
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="14"/>
                                            <TextBlock Text="{Binding Category}" FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Status / Bouton -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <!-- Badge installé -->
                                        <Border x:Name="InstalledBadge"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}"
                                                Background="{DynamicResource SuccessBrush}"
                                                CornerRadius="6" Padding="12,6"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✓" FontSize="11" Foreground="White"
                                                           FontWeight="Bold" Margin="0,0,6,0"/>
                                                <TextBlock Text="Installé" FontSize="11"
                                                           Foreground="White" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Bouton installer rouge -->
                                        <Border x:Name="InstallBtn"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibility}}"
                                                CornerRadius="6" Padding="14,6"
                                                VerticalAlignment="Center" Cursor="Hand"
                                                BorderThickness="0" Background="#E53935">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⬇" FontSize="11" Foreground="White"
                                                           Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Installer" FontSize="11.5"
                                                           Foreground="White" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Barre de statut -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                CornerRadius="8" Padding="14,10" Margin="0,12,0,0"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </Border>
        </Grid>

        <!-- Overlay popup - au-dessus de tout -->
    <Border x:Name="AppDetailOverlay" Visibility="Collapsed"
            Background="#99000000"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Panel.ZIndex="100" IsHitTestVisible="True"
            MouseLeftButtonDown="OnCloseOverlayBg">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource SurfaceBrush}" CornerRadius="12"
                Padding="36" Margin="40"
                BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                MaxWidth="600" MinWidth="420"
                MouseLeftButtonDown="OnDetailPopupClick">
            <StackPanel x:Name="DetailPopup">

                <!-- Header: icon + name + close button -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" x:Name="DetailIcon" Width="44" Height="44"
                           Margin="0,0,16,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="DetailName" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="DetailCategory" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <Border Grid.Column="2" Cursor="Hand" Background="{DynamicResource CardBrush}"
                            CornerRadius="6" Padding="8,4" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            VerticalAlignment="Top"
                            MouseLeftButtonDown="OnCloseOverlay">
                        <TextBlock Text="x" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>

                <!-- Package ID -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="6"
                        Padding="12,8" Margin="0,0,0,18"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                        Cursor="Hand" MouseLeftButtonDown="OnPackageIdClick">
                    <TextBlock x:Name="DetailPackageId" FontSize="12"
                               Foreground="#8B5CF6"
                               FontFamily="Consolas" TextDecorations="Underline"/>
                </Border>

                <!-- Description -->
                <TextBlock x:Name="DetailDescription" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,24" LineHeight="22"/>

                <!-- Boutons: Installer + En savoir plus -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <!-- Bouton installer -->
                    <Border x:Name="DetailInstallBtn" Cursor="Hand"
                            CornerRadius="8" Padding="0" BorderThickness="0"
                            HorizontalAlignment="Left"
                            MouseLeftButtonDown="OnDetailInstallClick"
                            Background="#E53935">
                        <StackPanel Orientation="Horizontal" Margin="20,10">
                            <TextBlock Text="&#x2B07;" FontSize="13" Foreground="White"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Installer via Winget" FontSize="13"
                                       Foreground="White" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Bouton En savoir plus -->
                    <Border x:Name="DetailLearnMoreBtn" Cursor="Hand"
                            CornerRadius="8" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Background="{DynamicResource CardBrush}"
                            HorizontalAlignment="Left" Margin="10,0,0,0"
                            PreviewMouseLeftButtonDown="OnDetailLearnMoreClick">
                        <StackPanel Orientation="Horizontal" Margin="20,10">
                            <TextBlock Text="&#x1F4C4;" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="En savoir plus" FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Status text -->
                <TextBlock x:Name="DetailStatus" FontSize="11" Margin="0,10,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="Collapsed"/>

            </StackPanel>
        </Border>
    </Border>
    </Grid>
</UserControl>
