<UserControl x:Class="CustomToolbox.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Style="{StaticResource InvisibleScrollViewer}">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left" VerticalAlignment="Top">

            <!-- En-tête -->
            <StackPanel Margin="0,0,0,36">
                <TextBlock Text="Bienvenue sur" FontSize="16"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Text="Custom Toolbox" FontSize="36" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,12"/>
                <TextBlock Text="Un outil pour personnaliser votre OS selon vos besoins"
                           FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Boutons d'action -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,40">
                <Button Content="📦 Explorer le catalogue"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,12,0"
                        Click="OnExploreApps_Click"/>
                <Button Content="📖 Consulter la FAQ"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>

            <!-- Liens rapides -->
            <TextBlock Text="Liens rapides" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

            <WrapPanel>
                <Border Style="{StaticResource QuickLinkCard}" Margin="0,0,12,12" Width="180">
                    <StackPanel>
                        <TextBlock Text="📁" FontSize="28" Margin="0,0,0,10"/>
                        <TextBlock Text="GitHub" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Code source" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource QuickLinkCard}" Margin="0,0,12,12" Width="180">
                    <StackPanel>
                        <TextBlock Text="💬" FontSize="28" Margin="0,0,0,10"/>
                        <TextBlock Text="Discord" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Rejoignez le serveur" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource QuickLinkCard}" Margin="0,0,12,12" Width="180">
                    <StackPanel>
                        <TextBlock Text="📖" FontSize="28" Margin="0,0,0,10"/>
                        <TextBlock Text="Documentation" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Guides et tutoriels" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource QuickLinkCard}" Margin="0,0,12,12" Width="180">
                    <StackPanel>
                        <TextBlock Text="🔧" FontSize="28" Margin="0,0,0,10"/>
                        <TextBlock Text="Wiki" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Base de connaissances" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Stats -->
            <TextBlock Text="Statistiques" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,16"/>

            <WrapPanel>
                <Border Style="{StaticResource SettingsCard}" Margin="0,0,12,0" MinWidth="150">
                    <StackPanel>
                        <TextBlock Text="100+" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="Applications" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}" Margin="0,0,12,0" MinWidth="150">
                    <StackPanel>
                        <TextBlock Text="8" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="Catégories" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SettingsCard}" MinWidth="150">
                    <StackPanel>
                        <TextBlock Text="100%" FontSize="28" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="Gratuit" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
