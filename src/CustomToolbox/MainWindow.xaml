<Window x:Class="CustomToolbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Views="clr-namespace:CustomToolbox.Views"
        Title="Downiso" Height="750" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Barre de titre -->
            <Grid Grid.Row="0" Background="{DynamicResource SidebarBrush}"
                  MouseLeftButtonDown="OnTitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Nom de l'app -->
                <TextBlock Text="Downiso" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                           FontWeight="SemiBold" Margin="14,0,0,0"/>

                <!-- Boutons navigation au centre -->
                <ListBox x:Name="SidebarNav" Grid.Column="1"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         SelectionChanged="OnNavigationChanged">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SidebarItemStyle}">
                            <Setter Property="Margin" Value="4,0"/>
                            <Setter Property="Padding" Value="14,7"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Tag="Apps" IsSelected="True">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Downiso;component/Resources/Icons/Applications.png"
                                   Width="20" Height="20" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Catalogue" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Settings">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Downiso;component/Resources/Icons/logoparametre.png"
                                   Width="20" Height="20" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Paramètres" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- Boutons fenetre -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="─" Style="{StaticResource IconButton}"
                            Click="OnMinimize_Click" Width="46" Height="40"/>
                    <Button Content="□" Style="{StaticResource IconButton}"
                            Click="OnMaximize_Click" Width="46" Height="40"/>
                    <Button Content="✕" Style="{StaticResource IconButton}"
                            Click="OnClose_Click" Width="46" Height="40"
                            Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Contenu -->
            <Grid Grid.Row="1" Margin="24,16">
                <Views:AppsView x:Name="AppsView" Visibility="Visible"/>
                <Views:OptimizeView x:Name="OptimizeView" Visibility="Collapsed"/>
                <Views:CustomizeView x:Name="CustomizeView" Visibility="Collapsed"/>
                <Views:SettingsView x:Name="SettingsView" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</Window>
